{
  "name": "@zigoschedule/scheduler-monorepo",
  "version": "0.3.1",
  "private": true,
  "description": "Professional scheduling UI for appointment booking, resources, drag/drop, resize, time zones and DST-safe business hours",
  "license": "MIT",
  "author": "Wagner Silva <contato@zigoapp.com.br>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "verify:frameworks": "npm run build && node scripts/verify-external-frameworks.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "ci:check": "node scripts/release-check.mjs --skip-audit",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "release:check": "node scripts/release-check.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:debt": "LINT_DEBT=1 eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "lucide-react": "^0.460.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagnersoares0/zigo-scheduler.git"
  },
  "homepage": "https://zigoschedule.com",
  "bugs": {
    "url": "https://github.com/wagnersoares0/zigo-scheduler/issues"
  },
  "keywords": [
    "zigo",
    "zigoschedule",
    "scheduler",
    "calendar",
    "appointments",
    "booking",
    "react",
    "web-component",
    "timezone",
    "dst",
    "drag-and-drop",
    "resize",
    "resources",
    "resource-scheduler",
    "appointment-scheduler",
    "multi-professional",
    "business-hours",
    "recurrence"
  ]
}
