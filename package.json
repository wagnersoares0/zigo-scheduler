{
  "name": "@zigoschedule/scheduler-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Professional scheduling UI for appointment booking, resources, drag/drop, resize, time zones and DST-safe business hours",
  "license": "MIT",
  "author": "Wagner Silva <contato@zigoapp.com.br>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "verify:frameworks": "npm run build && node scripts/verify-external-frameworks.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "ci:check": "node scripts/release-check.mjs --skip-audit",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "release:check": "node scripts/release-check.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:debt": "LINT_DEBT=1 eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "lucide-react": "^1.41.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rrule": "^2.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagnersoares0/zigo-scheduler.git"
  },
  "homepage": "https://zigoschedule.com",
  "bugs": {
    "url": "https://github.com/wagnersoares0/zigo-scheduler/issues"
  },
  "keywords": [
    "zigo",
    "zigoschedule",
    "scheduler",
    "calendar",
    "appointments",
    "booking",
    "react",
    "web-component",
    "timezone",
    "dst",
    "drag-and-drop",
    "resize",
    "resources",
    "resource-scheduler",
    "appointment-scheduler",
    "multi-professional",
    "business-hours",
    "recurrence"
  ]
}
