{
  "name": "@zigoschedule/scheduler-interaction",
  "version": "0.3.0",
  "description": "Pointer drag/drop, resize, mirror and auto-scroll primitives for professional scheduler UIs. DOM, no framework.",
  "license": "MIT",
  "author": "Wagner Silva <contato@zigoapp.com.br>",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagnersoares0/zigo-scheduler.git",
    "directory": "packages/interaction"
  },
  "homepage": "https://zigoschedule.com",
  "bugs": {
    "url": "https://github.com/wagnersoares0/zigo-scheduler/issues"
  },
  "keywords": [
    "zigo",
    "zigoschedule",
    "scheduler",
    "calendar",
    "appointments",
    "drag-and-drop",
    "resize",
    "resources",
    "resource-scheduler",
    "appointment-scheduler",
    "auto-scroll",
    "pointer-events"
  ],
  "publishConfig": {
    "access": "public"
  }
}
