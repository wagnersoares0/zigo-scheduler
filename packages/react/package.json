    "url": "https://github.com/wagnersoares0/zigo-scheduler/issues"
  },
  "keywords": [
    "zigo",
    "zigoschedule",
    "scheduler",
    "calendar",
    "appointments",
    "booking",
    "react",
    "typescript",
