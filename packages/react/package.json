{
  "name": "@zigoschedule/scheduler-react",
  "version": "0.3.2",
  "description": "React professional scheduler with resource columns, drag/drop, resize, business hours, buffers, time zones and DST-safe appointments.",
  "license": "MIT",
  "author": "Wagner Silva <contato@zigoapp.com.br>",
  "type": "module",
  "main": "./dist/index.cjs",
