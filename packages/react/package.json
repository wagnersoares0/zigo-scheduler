  "dependencies": {
    "@zigoschedule/scheduler-core": "^0.3.2",
    "@zigoschedule/scheduler-engine": "^0.3.2",
    "@zigoschedule/scheduler-interaction": "^0.3.2",
    "@zigoschedule/scheduler-layout": "^0.3.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "module": "./dist/index.js",
  "exports": {
